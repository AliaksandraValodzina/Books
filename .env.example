# Books — books.keepnook.app
#
# THE REPOSITORY IS PUBLIC. Nothing in this file ever carries a value: it names
# the variables and says what each one is for, and the values live in Vercel's
# environment settings and in a local `.env.local`, which `.gitignore` excludes.
#
# Everything below is OPTIONAL today. With none of it set the app runs, renders
# the page and writes the print file, serving the fixture photographs out of
# `fixtures/assets/`. That is the correct state until the captain points it at a
# bucket — inert rather than broken, which is the arrangement Keepnook uses for
# EXPO_PUBLIC_CONTENT_ORIGIN.

# ---------------------------------------------------------------------------
# Cloudflare R2 — where customers' photographs and template assets live
# ---------------------------------------------------------------------------

# Public read base for the bucket or the CDN in front of it, e.g.
# https://assets.books.keepnook.app . Objects are keyed by content hash:
# <sha256>.<ext>. Unset, assets are served from fixtures/assets via /api/assets.
#
# A CUSTOMER'S OWN PHOTOGRAPHS DO NOT GO THROUGH HERE YET. The editor resizes
# them in the browser and posts the bytes with the render request, which
# `lib/assets/supplied.ts` verifies against the digest, the type and the pixel
# size before drawing one. Storage arrives when orders do; until then there is
# nothing to upload and no credential to hold.
R2_PUBLIC_BASE_URL=

# Writing to the bucket — needed by upload, which is a later task. An account id
# is a credential for this purpose and belongs here with the rest of them.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Stripe — payments
# ---------------------------------------------------------------------------
#
# THE ONLY ONE THAT CHANGES ANYTHING TODAY is STRIPE_SECRET_KEY, and it is read
# in exactly one place: `lib/checkout.ts`, which decides between "payments are
# not switched on yet" and "configured, but the checkout is not finished". With
# it unset, `/api/checkout` answers 503 and `/checkout` says plainly that
# nothing has been charged — never a crash and never a fake success.
#
# A blank row, a placeholder, or a pasted variable NAME all count as unset: see
# `isSet` in lib/checkout.ts and the cases in test/checkout.test.ts. That is
# deliberate, because those are what a dashboard actually contains after a
# hurried first deploy, and each one would otherwise read as configured and
# fail further in.
#
# Set it in Vercel's environment settings. Nobody shares a key with anybody,
# and no value belongs in this file.
STRIPE_SECRET_KEY=

# Not read by anything yet. Named here so nobody is tempted to invent a home
# for them: the webhook that confirms a payment and the publishable key the
# browser would need both arrive with the real checkout.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Printify — uploading the print file against an order. A later task.
# ---------------------------------------------------------------------------

PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
